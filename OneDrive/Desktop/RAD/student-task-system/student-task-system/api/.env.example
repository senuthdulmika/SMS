# MongoDB Atlas connection string (from Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
DB_NAME=student_tasks

PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Use long random strings. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# The account registered with this email automatically becomes ADMIN
ADMIN_EMAIL=admin@crimson.dev
